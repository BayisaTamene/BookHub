generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  READER
  ADMIN
}

enum BookFileFormat {
  PDF
  EPUB
}

enum BookStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         Role     @default(READER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  favorites       Favorite[]
  readingProgress ReadingProgress[]
  booksCreated    Book[]            @relation("BookCreatedBy")
  booksUpdated    Book[]            @relation("BookUpdatedBy")

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("categories")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  biography String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  books BookAuthor[]

  @@map("authors")
}

model Book {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String    @db.VarChar(255)
  description         String?
  isbn                String?   @unique @db.VarChar(20)
  originalPublishedAt DateTime? @map("original_published_at")

  fileKey       String?         @unique @map("file_key")
  coverImageKey String?         @map("cover_image_key")
  fileFormat    BookFileFormat? @map("file_format")

  status      BookStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at")

  categoryId String @map("category_id") @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authors BookAuthor[]

  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdBy User @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("BookUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  favorites       Favorite[]
  readingProgress ReadingProgress[]

  @@map("books")
}

model BookAuthor {
  bookId   String @map("book_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@map("favorites")
}

model ReadingProgress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  bookId String @map("book_id") @db.Uuid

  currentPage Int?    @map("current_page")
  currentCfi  String? @map("current_cfi") @db.Text

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reading_progress")
}
